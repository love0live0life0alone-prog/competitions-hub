rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only @feng.bu.edu.eg accounts may read/write anything at all.
    function isUniversityAccount() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@feng[.]bu[.]edu[.]eg$');
    }

    function isAdmin() {
      return isUniversityAccount()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ---- users ----
    match /users/{userId} {
      // A student can create/read/update only their own profile,
      // and can never set their own role to "admin".
      allow read: if isUniversityAccount() && request.auth.uid == userId;
      allow create: if isUniversityAccount()
                    && request.auth.uid == userId
                    && request.resource.data.universityEmail == request.auth.token.email.lower()
                    && request.resource.data.role == "student";
      allow update: if isUniversityAccount()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.universityEmail == resource.data.universityEmail
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.createdAt == resource.data.createdAt; // identity fields are locked
      allow read, write: if isAdmin();
    }

    // ---- competitions ----
    match /competitions/{competitionId} {
      allow read: if isUniversityAccount();
      allow write: if isAdmin(); // creation/edits go through the Flask API, but this backstops direct writes

      // ---- competition media (photo gallery) ----
      match /media/{mediaId} {
        allow read: if isUniversityAccount();
        allow write: if isAdmin();
      }
    }

    // ---- competition_interactions ----
    match /competition_interactions/{docId} {
      // Written exclusively by the Flask backend (Admin SDK — bypasses these
      // rules) via /api/interactions, which also maintains the matching
      // competitions/{id}.stats counters in the same transaction. Students
      // never write here directly; only reading their own record is allowed.
      allow read: if isUniversityAccount()
                  && resource != null
                  && resource.data.studentId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ---- contacts (youth-care staff WhatsApp numbers) ----
    match /contacts/{contactId} {
      allow read: if isUniversityAccount();
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

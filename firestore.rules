rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only @feng.bu.edu.eg accounts may read/write anything at all.
    function isUniversityAccount() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@feng[.]bu[.]edu[.]eg$');
    }

    function isAdmin() {
      return isUniversityAccount()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ---- users ----
    match /users/{userId} {
      // A student can create/read/update only their own profile,
      // and can never set their own role to "admin".
      allow read: if isUniversityAccount() && request.auth.uid == userId;
      allow create: if isUniversityAccount()
                    && request.auth.uid == userId
                    && request.resource.data.universityEmail == request.auth.token.email
                    && request.resource.data.role == "student";
      allow update: if isUniversityAccount()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role; // role field is locked
      allow read, write: if isAdmin();
    }

    // ---- competitions ----
    match /competitions/{competitionId} {
      allow read: if isUniversityAccount();
      allow write: if isAdmin(); // creation/edits go through the Flask API, but this backstops direct writes
    }

    // ---- competition_interactions ----
    match /competition_interactions/{docId} {
      // A student may only read/write their own interaction record.
      allow read: if isUniversityAccount()
                  && resource.data.studentId == request.auth.uid;
      allow create, update: if isUniversityAccount()
                  && request.resource.data.studentId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ---- contacts (youth-care staff WhatsApp numbers) ----
    match /contacts/{contactId} {
      allow read: if isUniversityAccount();
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
